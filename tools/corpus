#!/usr/bin/env bash
# corpus [--check]: write docs/CORPUS.md (per .rs module: first //! line + pub items). --check: fail if stale.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
gen() { echo "# Code corpus (generated by tools/corpus; do not hand-edit)"; echo
  for f in $(git ls-files 'crates/*.rs' | sort); do
    echo "## $f"; sed -n 's|^//! *||p' "$f" | head -1
    grep -E '^\s*pub (fn|struct|enum|trait|type|const|mod) ' "$f" | sed -E 's/^\s*pub ([a-z]+) ([A-Za-z0-9_]+).*/- \1 \2/' | sort -u | head -40; echo; done; }
if [ "${1:-}" = --check ]; then diff -q <(gen) docs/CORPUS.md >/dev/null || { echo "CORPUS.md stale: run tools/corpus"; exit 1; }; echo ok
else gen > docs/CORPUS.md; fi
